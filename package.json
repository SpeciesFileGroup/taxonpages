{
  "name": "@sfgrp/taxonpages",
  "version": "0.5.4",
  "description": "CLI tool for building taxon pages powered by SpeciesFileGroup",
  "type": "module",
  "private": false,
  "bin": {
    "taxonpages": "./bin/taxonpages.js"
  },
  "files": [
    "bin/",
    "cli/",
    "src/",
    "templates/",
    "server.js",
    "index.html"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node bin/taxonpages.js dev",
    "dev:ssr": "node bin/taxonpages.js dev:ssr",
    "build": "node bin/taxonpages.js build",
    "build:ssr": "node bin/taxonpages.js build:ssr",
    "serve": "node bin/taxonpages.js serve",
    "debug": "node --inspect-brk server",
    "preview": "node bin/taxonpages.js preview",
    "setup": "node bin/taxonpages.js setup",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.19.3",
    "@nuxt/devalue": "^2.0.2",
    "@sfgrp/distinguish": "^0.4.6",
    "@sfgrp/pinpoint": "^0.0.12",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@unhead/ssr": "^3.1.0",
    "@unhead/vue": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.16.1",
    "commander": "^14.0.3",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "markdown-it-anchor": "^9.2.0",
    "minimist": "^1.2.8",
    "pinia": "^3.0.4",
    "sass": "^1.99.0",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.0",
    "unhead": "^3.1.0",
    "unplugin-vue-markdown": "^30.0.0",
    "vite": "^8.0.12",
    "vite-plugin-radar": "^0.10.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1"
  },
  "overrides": {
    "unplugin-vue-markdown": {
      "vite": "$vite"
    },
    "vite-plugin-radar": {
      "vite": "$vite"
    }
  },
  "keywords": [
    "taxonworks",
    "biodiversity",
    "taxonomy",
    "vue",
    "ssr",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpeciesFileGroup/taxonpages.git"
  }
}
