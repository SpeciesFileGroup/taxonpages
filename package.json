{
  "name": "@sfgrp/taxonpages",
  "version": "0.8.5",
  "description": "CLI tool for building taxon pages powered by SpeciesFileGroup",
  "type": "module",
  "private": false,
  "bin": {
    "taxonpages": "./bin/taxonpages.js"
  },
  "files": [
    "bin/",
    "cli/",
    "src/",
    "templates/",
    "server.js",
    "index.html",
    "!src/assets/css/sources.css",
    "!cli/setup/client/sources.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node bin/taxonpages.js dev",
    "dev:ssr": "node bin/taxonpages.js dev:ssr",
    "build": "node bin/taxonpages.js build",
    "build:ssr": "node bin/taxonpages.js build:ssr",
    "serve": "node bin/taxonpages.js serve",
    "debug": "node --inspect-brk server",
    "doctor": "node bin/taxonpages.js doctor",
    "preview": "node bin/taxonpages.js preview",
    "setup": "node bin/taxonpages.js setup",
    "lint": "eslint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:build": "vitest run --config tests/build/vitest.config.js",
    "prepublishOnly": "npm test && npm run test:build"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "@nuxt/devalue": "^2.0.2",
    "@sfgrp/distinguish": "^0.6.1",
    "@sfgrp/pinpoint": "^0.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/ssr": "^3.4.3",
    "@unhead/vue": "^3.4.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "markdown-it-anchor": "^10.0.0",
    "minimist": "^1.2.8",
    "pinia": "^4.1.0",
    "sass": "^1.106.1",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "unhead": "^3.4.3",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.5",
    "vite-plugin-radar": "^0.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "taxonworks",
    "biodiversity",
    "taxonomy",
    "vue",
    "ssr",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpeciesFileGroup/taxonpages.git"
  }
}
